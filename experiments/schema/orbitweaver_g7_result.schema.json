                "required": [
                  "dynamics_defect",
                  "path_violation",
                  "terminal_error",
                  "uncertainty_violation",
                  "integration_error"
                ],
                "type": "object"
              }
            },
            "type": "object"
          },
          "incumbent": {
            "minimum": 0,
            "type": "number"
