{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/terrorproforma/spacecraft-trajectory-optmiser/experiments/schema/paper1_result.schema.json",
  "title": "SpacePDHCG Paper 1 compact result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity",
    "dimensions",
    "quality",
    "timing",
    "work",
    "resources",
    "aggregation",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "repository_commit",
        "family",
        "instance_id",
        "solver",
        "policy",
        "status"
      ],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "repository_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "family": {
          "enum": [
            "P1-A-banded",
            "P1-B-hcw",
            "P1-C-pd3",
            "P1-D-pd6",
            "P1-E-low-thrust",
            "P1-F-robust-pd"
          ]
        },
        "instance_id": {"type": "string", "minLength": 1},
        "solver": {
          "enum": [
            "clarabel-cpu",
            "osqp-cpu",
            "pdhcg-upstream-one-shot",
            "spacepdhcg-persistent",
            "qoco-gpu",
            "cuclarabel",
            "structured-pipg",
            "hybrid-pdhcg-ipm"
          ]
        },
        "policy": {"type": "string", "minLength": 1},
        "status": {
          "enum": [
            "qualified",
            "unqualified",
            "hybrid_handoff_ineligible",
            "not_applicable",
            "unsupported",
            "oom",
            "timeout",
            "timeout_deterministic_replay",
            "numerical",
            "infeasible",
            "executor_defect",
            "unrun",
            "failed"
          ]
        },
        "hardware_id": {"type": ["string", "null"]},
        "precision": {"enum": ["float32", "float64", "mixed", null]},
        "warm_start": {"type": ["boolean", "null"]},
        "cold_start": {"type": ["boolean", "null"]},
        "gate": {"enum": ["G4", null]},
        "campaign": {"type": ["string", "null"]},
        "record_scope": {
          "enum": ["measured_attempt", "publication_aggregate", null]
        },
        "quality_tier": {"enum": ["coarse", "medium", "tight", "ipm", null]},
        "conditioning": {"$ref": "#/$defs/nonnegativeOrNull"},
        "scaling_mode": {
          "enum": ["always_refresh", "reuse", "refresh_if_needed", null]
        },
        "warm_mode": {"enum": ["cold", "primal", "primal_dual", null]},
        "seed": {"type": ["integer", "null"], "minimum": 0},
        "repeat_kind": {"enum": ["warmup", "measured", null]},
        "repeat": {"type": ["integer", "null"], "minimum": 0},
        "solver_order": {"type": ["integer", "null"], "minimum": 0},
        "failure_class": {
          "enum": [
            "none",
            "hybrid_handoff_ineligible",
            "not_applicable",
            "unsupported",
            "oom",
            "timeout",
            "numerical",
            "infeasible",
            "executor_defect",
            "max_iterations",
            "unrun",
            "evidence",
            null
          ]
        },
        "failure_reason": {"type": ["string", "null"]}
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intervals",
        "scenarios",
        "gpus",
        "state_dimension",
        "control_dimension",
        "variables",
        "scalar_rows",
        "affine_rows",
        "q_nonzeros",
        "a_nonzeros",
        "f_nonzeros",
        "cone_inventory"
      ],
      "properties": {
        "intervals": {"type": "integer", "minimum": 1},
        "scenarios": {"type": "integer", "minimum": 1},
        "gpus": {"type": "integer", "minimum": 0},
        "state_dimension": {"type": "integer", "minimum": 1},
        "control_dimension": {"type": "integer", "minimum": 1},
        "variables": {"type": "integer", "minimum": 1},
        "scalar_rows": {"type": "integer", "minimum": 0},
        "affine_rows": {"type": "integer", "minimum": 0},
        "q_nonzeros": {"type": "integer", "minimum": 0},
        "a_nonzeros": {"type": "integer", "minimum": 0},
        "f_nonzeros": {"type": "integer", "minimum": 0},
        "cone_inventory": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "topology_bytes": {"type": ["integer", "null"], "minimum": 0},
        "numeric_bytes": {"type": ["integer", "null"], "minimum": 0},
        "dispersion_class": {"$ref": "#/$defs/nonnegativeOrNull"},
        "attitude_class": {"$ref": "#/$defs/nonnegativeOrNull"},
        "rate_class": {"$ref": "#/$defs/nonnegativeOrNull"},
        "transfer_class": {"type": ["string", "null"]},
        "trust_class": {"$ref": "#/$defs/nonnegativeOrNull"}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualified",
        "objective",
        "canonical_primal_residual",
        "canonical_dual_residual",
        "canonical_cone_residual",
        "canonical_gap",
        "dynamics_residual",
        "path_residual",
        "terminal_residual",
        "virtual_control_residual",
        "nonanticipativity_residual",
        "risk_epigraph_residual"
      ],
      "properties": {
        "qualified": {"type": "boolean"},
        "objective": {"$ref": "#/$defs/finiteOrNull"},
        "reference_objective": {"$ref": "#/$defs/finiteOrNull"},
        "objective_gap": {"$ref": "#/$defs/nonnegativeOrNull"},
        "canonical_primal_residual": {"$ref": "#/$defs/nonnegativeOrNull"},
        "canonical_dual_residual": {"$ref": "#/$defs/nonnegativeOrNull"},
        "canonical_cone_residual": {"$ref": "#/$defs/nonnegativeOrNull"},
        "canonical_gap": {"$ref": "#/$defs/nonnegativeOrNull"},
        "native_primal_residual": {"$ref": "#/$defs/nonnegativeOrNull"},
        "native_dual_residual": {"$ref": "#/$defs/nonnegativeOrNull"},
        "dynamics_residual": {"$ref": "#/$defs/nonnegativeOrNull"},
        "path_residual": {"$ref": "#/$defs/nonnegativeOrNull"},
        "terminal_residual": {"$ref": "#/$defs/nonnegativeOrNull"},
        "virtual_control_residual": {"$ref": "#/$defs/nonnegativeOrNull"},
        "nonanticipativity_residual": {"$ref": "#/$defs/nonnegativeOrNull"},
        "risk_epigraph_residual": {"$ref": "#/$defs/nonnegativeOrNull"},
        "ct_error_estimate": {"$ref": "#/$defs/nonnegativeOrNull"},
        "requested_tolerance": {"$ref": "#/$defs/nonnegativeOrNull"},
        "achieved_residual": {"$ref": "#/$defs/nonnegativeOrNull"},
        "continuous_time_violation": {"$ref": "#/$defs/nonnegativeOrNull"},
        "solver_status": {
          "enum": [
            "converged",
            "max_iterations",
            "numerical_failure",
            "infeasible",
            "executor_defect",
            "hybrid_handoff_ineligible",
            "not_applicable",
            "unsupported",
            null
          ]
        },
        "convergence_criteria_met": {"type": ["boolean", "null"]},
        "objective_equivalent": {"type": ["boolean", "null"]},
        "matched_quality_state": {"enum": ["matched", "unqualified", null]},
        "independent_replay": {"type": ["boolean", "null"]},
        "path_inventory_complete": {"type": ["boolean", "null"]},
        "uses_solver_cached_residuals": {"type": ["boolean", "null"]},
        "path_inventory": {
          "type": ["object", "null"],
          "additionalProperties": {"$ref": "#/$defs/pathCheck"}
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topology_seconds",
        "coefficient_seconds",
        "workspace_create_seconds",
        "update_seconds",
        "scaling_seconds",
        "h2d_seconds",
        "solve_seconds",
        "residual_seconds",
        "replay_seconds",
        "acceptance_seconds",
        "d2h_seconds",
        "collective_seconds",
        "cqp_total_seconds",
        "scvx_total_seconds"
      ],
      "properties": {
        "topology_seconds": {"$ref": "#/$defs/nonnegativeOrNull"},
        "coefficient_seconds": {"$ref": "#/$defs/nonnegativeOrNull"},
        "workspace_create_seconds": {"$ref": "#/$defs/nonnegativeOrNull"},
        "update_seconds": {"$ref": "#/$defs/nonnegativeOrNull"},
        "scaling_seconds": {"$ref": "#/$defs/nonnegativeOrNull"},
        "h2d_seconds": {"$ref": "#/$defs/nonnegativeOrNull"},
        "solve_seconds": {"$ref": "#/$defs/nonnegativeOrNull"},
        "residual_seconds": {"$ref": "#/$defs/nonnegativeOrNull"},
        "replay_seconds": {"$ref": "#/$defs/nonnegativeOrNull"},
        "acceptance_seconds": {"$ref": "#/$defs/nonnegativeOrNull"},
        "d2h_seconds": {"$ref": "#/$defs/nonnegativeOrNull"},
        "collective_seconds": {"$ref": "#/$defs/nonnegativeOrNull"},
        "cqp_total_seconds": {"$ref": "#/$defs/nonnegativeOrNull"},
        "scvx_total_seconds": {"$ref": "#/$defs/nonnegativeOrNull"},
        "accepted_trajectory_seconds": {"$ref": "#/$defs/nonnegativeOrNull"},
        "recovery_seconds": {"$ref": "#/$defs/nonnegativeOrNull"},
        "hybrid_conversion_seconds": {"$ref": "#/$defs/nonnegativeOrNull"},
        "hybrid_setup_seconds": {"$ref": "#/$defs/nonnegativeOrNull"},
        "polish_seconds": {"$ref": "#/$defs/nonnegativeOrNull"},
        "cuda_startup_seconds": {"$ref": "#/$defs/nonnegativeOrNull"},
        "cuda_startup_included": {"type": ["boolean", "null"]},
        "accepted_trajectory_count": {"type": ["integer", "null"], "minimum": 1},
        "accepted_timing_boundary": {"type": ["string", "null"]},
        "cqp_total_identity": {
          "type": ["array", "null"],
          "items": {"type": "string"}
        },
        "scvx_total_identity": {
          "type": ["array", "null"],
          "items": {"type": "string"}
        }
      }
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outer_iterations",
        "inner_iterations",
        "matvecs",
        "cone_projections",
        "factorisations",
        "accepted_steps",
        "rejected_steps",
        "resolved_steps",
        "polish_used"
      ],
      "properties": {
        "outer_iterations": {"type": ["integer", "null"], "minimum": 0},
        "inner_iterations": {"type": ["integer", "null"], "minimum": 0},
        "matvecs": {"type": ["integer", "null"], "minimum": 0},
        "cone_projections": {"type": ["integer", "null"], "minimum": 0},
        "factorisations": {"type": ["integer", "null"], "minimum": 0},
        "accepted_steps": {"type": ["integer", "null"], "minimum": 0},
        "rejected_steps": {"type": ["integer", "null"], "minimum": 0},
        "resolved_steps": {"type": ["integer", "null"], "minimum": 0},
        "polish_used": {"type": ["boolean", "null"]},
        "scaling_refreshes": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "peak_device_bytes",
        "reserved_device_bytes",
        "h2d_bytes",
        "d2h_bytes",
        "collective_bytes",
        "collective_count",
        "energy_joules",
        "topology_allocation_count_after_create"
      ],
      "properties": {
        "peak_device_bytes": {"type": ["integer", "null"], "minimum": 0},
        "reserved_device_bytes": {"type": ["integer", "null"], "minimum": 0},
        "h2d_bytes": {"type": ["integer", "null"], "minimum": 0},
        "d2h_bytes": {"type": ["integer", "null"], "minimum": 0},
        "collective_bytes": {"type": ["integer", "null"], "minimum": 0},
        "collective_count": {"type": ["integer", "null"], "minimum": 0},
        "energy_joules": {"$ref": "#/$defs/nonnegativeOrNull"},
        "topology_allocation_count_after_create": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "load_imbalance": {"$ref": "#/$defs/nonnegativeOrNull"},
        "throughput_per_second": {"$ref": "#/$defs/nonnegativeOrNull"},
        "energy_scope": {"enum": ["GPU-only", null]},
        "energy_sampling_interval_milliseconds": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "energy_maximum_gap_seconds": {"$ref": "#/$defs/nonnegativeOrNull"},
        "energy_sampling_gaps": {"type": ["boolean", "null"]},
        "energy_valid": {"type": ["boolean", "null"]},
        "shared_or_display_gpu": {"type": ["boolean", "null"]}
      }
    },
    "aggregation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warmup_repeats",
        "measured_repeats",
        "statistic",
        "median",
        "q1",
        "q3",
        "minimum",
        "maximum",
        "coefficient_of_variation",
        "censored_count"
      ],
      "properties": {
        "warmup_repeats": {"type": "integer", "minimum": 0},
        "measured_repeats": {"type": "integer", "minimum": 0},
        "statistic": {"const": "median_iqr"},
        "median": {"$ref": "#/$defs/nonnegativeOrNull"},
        "q1": {"$ref": "#/$defs/nonnegativeOrNull"},
        "q3": {"$ref": "#/$defs/nonnegativeOrNull"},
        "minimum": {"$ref": "#/$defs/nonnegativeOrNull"},
        "maximum": {"$ref": "#/$defs/nonnegativeOrNull"},
        "coefficient_of_variation": {"$ref": "#/$defs/nonnegativeOrNull"},
        "censored_count": {"type": "integer", "minimum": 0},
        "bootstrap_low": {"$ref": "#/$defs/finiteOrNull"},
        "bootstrap_high": {"$ref": "#/$defs/finiteOrNull"},
        "instance_count": {"type": ["integer", "null"], "minimum": 0},
        "evaluation_seed_count": {"type": ["integer", "null"], "minimum": 0},
        "paired_bootstrap_samples": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "raw", "stdout", "stderr"],
      "properties": {
        "manifest": {"$ref": "#/$defs/artifact"},
        "raw": {"$ref": "#/$defs/artifact"},
        "stdout": {"$ref": "#/$defs/artifact"},
        "stderr": {"$ref": "#/$defs/artifact"},
        "nsys": {"$ref": "#/$defs/artifactOrNull"},
        "ncu": {"$ref": "#/$defs/artifactOrNull"},
        "compute_sanitizer": {"$ref": "#/$defs/artifactOrNull"},
        "energy_trace": {"$ref": "#/$defs/artifactOrNull"}
      }
    },
    "g4": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_sha256",
        "runtime_requested",
        "runtime_actual",
        "outer_iterations",
        "hybrid_permutation",
        "hybrid_dual_disposition"
      ],
      "properties": {
        "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "runtime_requested": {"$ref": "#/$defs/g4Runtime"},
        "runtime_actual": {"$ref": "#/$defs/g4Runtime"},
        "outer_iterations": {
          "type": "array",
          "items": {"$ref": "#/$defs/g4OuterIteration"}
        },
        "hybrid_permutation": {
          "type": ["array", "null"],
          "items": {"type": "integer", "minimum": 0}
        },
        "hybrid_dual_disposition": {
          "enum": [
            "transferred",
            "discarded_unsupported",
            "discarded-unsupported",
            "not-produced",
            null
          ]
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "identity": {
            "properties": {
              "gate": {"const": "G4"},
              "campaign": {"const": "g4-primary"}
            },
            "required": ["gate", "campaign"]
          }
        }
      },
      "then": {
        "required": ["g4"],
        "properties": {
          "identity": {
            "required": [
              "gate",
              "campaign",
              "quality_tier",
              "conditioning",
              "scaling_mode",
              "warm_mode",
              "seed",
              "repeat_kind",
              "repeat",
              "solver_order",
              "failure_class",
              "failure_reason"
            ]
          },
          "quality": {
            "required": [
              "continuous_time_violation",
              "solver_status",
              "convergence_criteria_met",
              "objective_equivalent",
              "matched_quality_state",
              "independent_replay",
              "path_inventory_complete",
              "uses_solver_cached_residuals",
              "path_inventory"
            ]
          },
          "timing": {
            "required": [
              "accepted_trajectory_seconds",
              "recovery_seconds",
              "hybrid_conversion_seconds",
              "hybrid_setup_seconds",
              "polish_seconds",
              "cuda_startup_seconds",
              "cuda_startup_included",
              "accepted_trajectory_count",
              "accepted_timing_boundary",
              "cqp_total_identity",
              "scvx_total_identity"
            ]
          },
          "resources": {
            "required": [
              "energy_scope",
              "energy_sampling_interval_milliseconds",
              "energy_maximum_gap_seconds",
              "energy_sampling_gaps",
              "energy_valid",
              "shared_or_display_gpu"
            ]
          },
          "aggregation": {
            "required": [
              "instance_count",
              "evaluation_seed_count",
              "paired_bootstrap_samples"
            ]
          },
          "artifacts": {
            "properties": {
              "manifest": {"$ref": "#/$defs/g4Artifact"},
              "raw": {"$ref": "#/$defs/g4Artifact"},
              "stdout": {"$ref": "#/$defs/g4Artifact"},
              "stderr": {"$ref": "#/$defs/g4Artifact"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "finiteOrNull": {
      "type": ["number", "null"]
    },
    "nonnegativeOrNull": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location", "sha256"],
      "properties": {
        "location": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "immutable_uri": {"type": "string", "minLength": 1},
        "internal_index_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "portable": {"type": "boolean"}
      }
    },
    "g4Artifact": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {
          "required": ["immutable_uri", "internal_index_sha256", "portable"]
        }
      ]
    },
    "g4Runtime": {
      "type": "object",
      "required": ["policy", "quality_tier", "scaling_mode", "warm_mode"],
      "properties": {
        "policy": {"type": "string", "minLength": 1},
        "quality_tier": {"enum": ["coarse", "medium", "tight", "ipm"]},
        "scaling_mode": {"enum": ["always_refresh", "reuse", "refresh_if_needed"]},
        "warm_mode": {"enum": ["cold", "primal", "primal_dual"]}
      }
    },
    "g4OuterIteration": {
      "type": "object",
      "required": [
        "phase",
        "requested_tolerance",
        "achieved_residual",
        "forcing_satisfied",
        "trust_before",
        "trust_after",
        "trust_action",
        "re_solved",
        "cqp_fingerprint",
        "resolve_fingerprint",
        "fingerprint_match",
        "scaling_refreshed",
        "predicted_reduction",
        "actual_reduction",
        "reduction_ratio",
        "scaling_min",
        "scaling_max",
        "warm_mode_actual",
        "recovery_reason",
        "polish_handoff",
        "accepted"
      ],
      "properties": {
        "phase": {"enum": ["repair", "progress", "refinement", "polish"]},
        "requested_tolerance": {"type": "number", "minimum": 0},
        "achieved_residual": {"type": "number", "minimum": 0},
        "forcing_satisfied": {"type": "boolean"},
        "trust_before": {"type": "number", "minimum": 0},
        "trust_after": {"type": "number", "minimum": 0},
        "trust_action": {"enum": ["retain", "shrink", "expand"]},
        "re_solved": {"type": "boolean"},
        "cqp_fingerprint": {"type": "string", "minLength": 1},
        "resolve_fingerprint": {"type": "string", "minLength": 1},
        "fingerprint_match": {"type": "boolean"},
        "scaling_refreshed": {"type": "boolean"},
        "predicted_reduction": {"type": "number", "minimum": 0},
        "actual_reduction": {"type": "number"},
        "reduction_ratio": {"type": "number"},
        "scaling_min": {"type": "number", "minimum": 0},
        "scaling_max": {"type": "number", "minimum": 0},
        "warm_mode_actual": {"enum": ["cold", "primal", "primal_dual"]},
        "recovery_reason": {"type": "string", "minLength": 1},
        "polish_handoff": {"type": "boolean"},
        "accepted": {"type": "boolean"}
      }
    },
    "pathCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["violation", "independent"],
      "properties": {
        "violation": {"type": "number", "minimum": 0},
        "independent": {"type": "boolean"}
      }
    },
    "artifactOrNull": {
      "anyOf": [
        {"$ref": "#/$defs/artifact"},
        {"type": "null"}
      ]
    }
  }
}
