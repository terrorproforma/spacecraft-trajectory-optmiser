{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spacepdhcg.invalid/schema/literature_provenance.schema.json",
  "title": "SpacePDHCG literature provenance store",
  "description": "Machine-readable provenance for every literature-derived value used by the comparative solver campaign (docs/COMPARATIVE_SOLVER_CAMPAIGN.md, 'Literature evidence policy').",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_document", "generated_by", "records"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "policy_document": { "const": "docs/COMPARATIVE_SOLVER_CAMPAIGN.md" },
    "generated_by": { "type": "string", "minLength": 1 },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "evidence_label": {
      "type": "string",
      "enum": [
        "analytic",
        "published-reference",
        "reproduced-external",
        "measured-local",
        "descriptive-only"
      ]
    },
    "extraction_method": {
      "type": "string",
      "enum": [
        "text",
        "table",
        "equation",
        "figure-digitised",
        "code",
        "data-file",
        "computed-from-source-values",
        "secondary-citation",
        "manifest-import",
        "local-measurement",
        "unrecoverable"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "authors": { "type": "string" },
        "year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
        "doi": { "type": ["string", "null"] },
        "url": { "type": "string", "pattern": "^(https?://|file:).+" },
        "version": { "type": "string", "description": "edition, arXiv version, repository revision, or release tag" },
        "revision": { "type": ["string", "null"], "description": "git commit or archive identity when applicable" },
        "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "location": { "type": "string", "description": "table, equation, section, page, figure, or file path inside the source" },
        "licence": { "type": ["string", "null"] },
        "accessed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "profile",
        "quantity",
        "value",
        "value_text",
        "units",
        "evidence_label",
        "extraction_method",
        "approximate",
        "source"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.\\-_/]*$" },
        "profile": { "type": "string", "minLength": 1 },
        "quantity": { "type": "string", "minLength": 1 },
        "value": {
          "description": "Numeric value, vector, or verbatim string as supplied by the source; null only for descriptive-only records.",
          "type": ["number", "array", "string", "null", "boolean"]
        },
        "value_text": {
          "type": "string",
          "description": "All digits exactly as printed by the source (no rounding, no inferred precision)."
        },
        "units": { "type": "string" },
        "evidence_label": { "$ref": "#/$defs/evidence_label" },
        "extraction_method": { "$ref": "#/$defs/extraction_method" },
        "approximate": { "type": "boolean" },
        "source": { "$ref": "#/$defs/source" },
        "secondary_source": { "$ref": "#/$defs/source" },
        "objective_convention": {
          "type": ["string", "null"],
          "description": "e.g. propellant-used, final-mass, time-of-flight, total-delta-v; prevents mixing conventions."
        },
        "unrecoverable_reason": { "type": ["string", "null"] },
        "verification_status": {
          "type": "string",
          "enum": ["source-verified", "requires-source-verification", "not-applicable"]
        },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "extraction_method": { "const": "figure-digitised" } } },
          "then": { "properties": { "approximate": { "const": true } } }
        },
        {
          "if": { "properties": { "evidence_label": { "const": "descriptive-only" } } },
          "then": { "required": ["unrecoverable_reason"], "properties": { "unrecoverable_reason": { "type": "string", "minLength": 1 } } }
        },
        {
          "if": { "properties": { "extraction_method": { "const": "secondary-citation" } } },
          "then": { "required": ["secondary_source"] }
        }
      ]
    }
  }
}
