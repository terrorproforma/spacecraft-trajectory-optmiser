                  "minimum": 0,
                  "type": "number"
                },
                "integration_error": {
                  "minimum": 0,
                  "type": "number"
                },
                "path_violation": {
                  "minimum": 0,
                  "type": "number"
                },
                "terminal_error": {
                  "minimum": 0,
