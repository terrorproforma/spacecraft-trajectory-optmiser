{
  "schema_version": "2.0.0",
  "programme": "SpacePDHCG Paper 1",
  "status": "preregistered pre-GPU matrix",
  "repository": "terrorproforma/spacecraft-trajectory-optmiser",
  "upstream_pdhcg_commit": "167c8b72b4b96d2f94d405b8763e485514192b81",
  "precision": "float64",
  "warmup_repeats": 2,
  "measured_repeats": 7,
  "randomised_instances_per_coordinate": 20,
  "requested_tolerances": [0.001, 0.0001, 0.000001, 0.00000001],
  "warm_start_modes": ["cold", "primal", "primal_dual"],
  "scaling_modes": ["always_refresh", "reuse", "refresh_if_needed"],
  "inner_accuracy_modes": [
    "fixed-tight",
    "fixed-loose",
    "adaptive",
    "adaptive+polish"
  ],
  "comparative_campaign": "docs/COMPARATIVE_SOLVER_CAMPAIGN.md",
  "literature_baselines": "benchmarks/literature_baselines.json",
  "comparison_layers": [
    {
      "id": "same-cqp",
      "purpose": "isolate conic backend accuracy, persistence, latency, and memory",
      "requires_common_problem_data": true,
      "requires_common_hardware_for_speed": true,
      "published_timing_use": "context_only"
    },
    {
      "id": "end-to-end-system",
      "purpose": "compare complete trajectory-optimisation systems at matched independently checked nonlinear quality",
      "requires_common_problem_data": false,
      "requires_common_physical_problem": true,
      "requires_common_hardware_for_speed": true,
      "published_timing_use": "context_only"
    },
    {
      "id": "capability-scaling",
      "purpose": "identify horizon, scenario, memory, and multi-GPU crossovers",
      "requires_common_problem_data": false,
      "requires_common_physical_problem": true,
      "requires_common_hardware_for_speed": true,
      "published_timing_use": "context_only"
    }
  ],
  "system_baselines": [
    {
      "id": "openscvx",
      "role": "open end-to-end CT-SCvx comparison",
      "families": ["P1-B-hcw", "P1-C-pd3", "P1-D-pd6"],
      "revision": null,
      "required_before_run": "pin commit and archive configuration"
    },
    {
      "id": "scptoolbox",
      "role": "open reference SCP implementation",
      "families": ["P1-C-pd3", "P1-D-pd6"],
      "revision": null,
      "required_before_run": "pin maintained repository revision and archive configuration"
    },
    {
      "id": "scvxgen",
      "role": "generated 6-DoF SCvx implementation",
      "families": ["P1-D-pd6"],
      "revision": null,
      "required_before_run": "pin generator and generated-code revisions"
    },
    {
      "id": "casadi-ipopt",
      "role": "general direct-NLP end-to-end comparison",
      "families": ["P1-B-hcw", "P1-C-pd3", "P1-D-pd6", "P1-E-low-thrust"],
      "revision": null,
      "required_before_run": "freeze transcription, dependency versions, options, and tuning budget"
    },
    {
      "id": "pykep-ipopt",
      "role": "TOPS low-thrust reference implementation",
      "families": ["P1-E-low-thrust"],
      "revision": null,
      "required_before_run": "pin pykep, pygmo, IPOPT, TOPS JSON, and selected cases"
    }
  ],
  "solver_backends": [
    {
      "id": "clarabel-cpu",
      "role": "conic correctness reference",
      "requires_gpu": false
    },
    {
      "id": "osqp-cpu",
      "role": "QP correctness reference",
      "requires_gpu": false
    },
    {
      "id": "pdhcg-upstream-one-shot",
      "role": "pinned upstream CUDA compatibility and one-shot baseline",
      "requires_gpu": true
    },
    {
      "id": "spacepdhcg-persistent",
      "role": "primary persistent factorisation-free backend",
      "requires_gpu": true
    },
    {
      "id": "qoco-gpu",
      "role": "quadratic-objective GPU interior-point comparison",
      "requires_gpu": true
    },
    {
      "id": "cuclarabel",
      "role": "general GPU conic interior-point comparison",
      "requires_gpu": true
    },
    {
      "id": "structured-pipg",
      "role": "trajectory-structured first-order comparison where implemented",
      "requires_gpu": false
    },
    {
      "id": "hybrid-pdhcg-ipm",
      "role": "persistent PDHCG construction followed by GPU IPM polish",
      "requires_gpu": true
    }
  ],
  "campaigns": [
    {
      "id": "gate-0-cpu",
      "purpose": "host and native truth models",
      "families": [
        "P1-A-banded",
        "P1-B-hcw",
        "P1-C-pd3",
        "P1-D-pd6",
        "P1-E-low-thrust",
        "P1-F-robust-pd"
      ]
    },
    {
      "id": "gate-1-one-shot",
      "purpose": "real pinned upstream CUDA correctness",
      "families": ["P1-A-banded", "P1-B-hcw"]
    },
    {
      "id": "gate-2-persistence",
      "purpose": "H1 persistent ownership and update lifecycle",
      "families": ["P1-A-banded", "P1-B-hcw", "P1-C-pd3"]
    },
    {
      "id": "gate-3-deterministic-scvx",
      "purpose": "end-to-end nonlinear single-GPU scaling",
      "families": ["P1-C-pd3", "P1-D-pd6", "P1-E-low-thrust"]
    },
    {
      "id": "gate-4-adaptive-hybrid",
      "purpose": "H5 and H6 policy comparisons",
      "families": ["P1-C-pd3", "P1-D-pd6", "P1-E-low-thrust"]
    },
    {
      "id": "gate-5-multigpu",
      "purpose": "H2, H3, and H4 scenario-aware scaling",
      "families": ["P1-F-robust-pd"]
    }
  ],
  "families": [
    {
      "id": "P1-A-banded",
      "name": "known-optimum trajectory-banded CQP",
      "intervals": [10, 50, 100, 500, 2000, 10000, 50000],
      "state_dimensions": [4, 7, 14],
      "control_dimensions": [3, 4, 7],
      "control_sets": ["box", "soc"],
      "weight_log10_spans": [0.0, 2.0, 4.0, 8.0],
      "seeds": [17, 23, 31, 47, 59, 71, 89, 101, 127, 149, 173, 197, 223, 251, 281, 313, 349, 389, 431, 479, 521, 569, 617, 659]
    },
    {
      "id": "P1-B-hcw",
      "name": "HCW rendezvous",
      "intervals": [20, 50, 100, 500, 2000, 10000],
      "control_sets": ["box", "soc"],
      "update_magnitudes": [0.0, 0.001, 0.01, 0.1, 1.0]
    },
    {
      "id": "P1-C-pd3",
      "name": "3-DoF powered descent SCvx",
      "intervals": [20, 50, 100, 500, 2000],
      "initial_dispersion_scales": [0.0, 0.01, 0.05, 0.1],
      "final_polish": [false, true]
    },
    {
      "id": "P1-D-pd6",
      "name": "14-state 6-DoF powered descent SCvx",
      "intervals": [20, 50, 100, 500, 2000],
      "attitude_dispersion_radians": [0.0, 0.05, 0.2, 0.5],
      "angular_rate_dispersion": [0.0, 0.05, 0.2],
      "final_polish": [false, true]
    },
    {
      "id": "P1-E-low-thrust",
      "name": "long-horizon two-body low thrust",
      "intervals": [100, 500, 2000, 10000, 50000],
      "trust_radii": [0.25, 0.5, 1.0, 2.0],
      "transfer_classes": ["coast_reference", "radius_raise", "plane_change", "combined"]
    },
    {
      "id": "P1-F-robust-pd",
      "name": "robust powered-descent scenarios",
      "intervals": [20, 50, 100, 500],
      "scenario_counts": [1, 10, 100, 1000, 10000],
      "common_prefix_fractions": [0.0, 0.25, 0.5, 1.0],
      "risk_metrics": ["expected", "worst", "cvar_0.9", "cvar_0.99"],
      "gpu_counts": [1, 2, 4, 8]
    }
  ],
  "required_quality_fields": [
    "objective",
