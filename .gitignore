# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Environments
.venv/
.venv-*/
venv/
env/

# Builds
build/
build-*/
dist/

# Editors and operating systems
.DS_Store
.idea/
.vscode/

# Native/CUDA builds
cmake-build-*/
CMakeFiles/
CMakeCache.txt
*.o
*.so
*.dylib
*.dll
_upstream/

# Benchmark output is generated by CI or explicit experiments
artifacts/
results/
visualization-output/

# GTOC12 pinned external data (fetched by scripts/gtoc12/fetch_gtoc12_data.py)
benchmarks/gtoc12/data/

# Generated multi-MB GTOC12 viewer dataset (web/trajectory-viewer/README.md: npm run import-gtoc12)
web/trajectory-viewer/data/gtoc12/

# SSH private keys (never commit)
*.pem
traj-key*

# Root scratch files (moved to %LOCALAPPDATA%\Temp\spacepdhcg-tmp\ on Windows)
.tmp_*

# Lambda H100 evidence: compact summaries/manifests/verification JSON/small logs are force-added under
# results/lambda-h100 (see its INDEX.json); the raw parts stay out even if results/ is ever un-ignored
results/lambda-h100/bundles/
results/lambda-h100/viewer/
results/lambda-h100/**/viewer/
results/lambda-h100/gtoc12/*/fleet/
results/lambda-h100/gtoc12/*/fleets/
results/lambda-h100/gtoc12/*/clusters/
results/lambda-h100/gtoc12/*/ships.jsonl
results/lambda-h100/gtoc12/*/official_verification.json
results/lambda-h100/**/stdout.jsonl
results/lambda-h100/**/*.sqlite3
results/lambda-h100/**/*.tar.gz
results/lambda-h100/**/*.csv
results/lambda-h100/*.patch
