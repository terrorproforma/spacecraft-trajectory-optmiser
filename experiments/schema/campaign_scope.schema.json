{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/terrorproforma/spacecraft-trajectory-optmiser/experiments/schema/campaign_scope.schema.json",
  "title": "Versioned GPU campaign scope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope_id",
    "status",
    "supersedes_completion_goal",
    "active_requirements",
    "deferred_requirements",
    "active_hypotheses",
    "deferred_hypotheses",
    "included_products",
    "deferred_products",
    "allowed_gpu_counts",
    "requires_physical_g5"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "scope_id": {"enum": ["single-gpu-v1", "full-multi-gpu-v1"]},
    "status": {"enum": ["active", "historical"]},
    "supersedes_completion_goal": {"type": ["string", "null"]},
    "active_requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "deferred_requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "active_hypotheses": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["H1", "H2", "H3", "H4", "H5", "H6"]}
    },
    "deferred_hypotheses": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["H1", "H2", "H3", "H4", "H5", "H6"]}
    },
    "included_products": {
      "type": "array",
      "uniqueItems": true,
      "items": {"pattern": "^[FT][0-9]{2}$"}
    },
    "deferred_products": {
      "type": "array",
      "uniqueItems": true,
      "items": {"pattern": "^[FT][0-9]{2}$"}
    },
    "allowed_gpu_counts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    },
    "requires_physical_g5": {"type": "boolean"}
  }
}
