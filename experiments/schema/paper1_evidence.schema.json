{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/terrorproforma/spacecraft-trajectory-optmiser/experiments/schema/paper1_evidence.schema.json",
  "title": "Paper 1 archived run evidence envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "manifest_sha256",
    "result_sha256",
    "residual_evidence",
    "replay_evidence",
    "archive"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "result_sha256": {"$ref": "#/$defs/sha256"},
    "residual_evidence": {"$ref": "#/$defs/artifact"},
    "replay_evidence": {"$ref": "#/$defs/artifact"},
    "archive": {"$ref": "#/$defs/artifact"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256", "internal_index_sha256", "media_type"],
      "properties": {
        "uri": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "internal_index_sha256": {"$ref": "#/$defs/sha256"},
        "media_type": {"type": "string", "minLength": 1},
        "local_path": {"type": ["string", "null"]}
      }
    }
  }
}
